						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[
int i = southSeq++;

agent.sequence = trainSeq++;
agent.trainId = "S" + (i + 1);


agent.scheduledArrival = time();

agent.incomingDelay =
    generateIncomingDelay(agent.trainId);

agent.readyTime =
    agent.scheduledArrival + agent.incomingDelay;


agent.minDwell = 3;
agent.scheduledDeparture = time() + 5;

agent.assignedPlatform = -1;

switch (i % 3) {

    case 0:
        agent.routeGroup = "RB16_N";
        agent.plannedPlatform = 5;
        agent.allowedPlatforms = new int[]{4, 5};
        break;

    case 1:
        agent.routeGroup = "RE1_N";
        agent.plannedPlatform = 4;
        agent.allowedPlatforms = new int[]{4, 5};
        break;

    default:
        agent.routeGroup = "ICE_N";
        agent.plannedPlatform = 4;
        agent.allowedPlatforms = new int[]{4, 5};
        break;
}

traceln(
    "NEW TRAIN | " + agent.trainId +
    " | " + agent.routeGroup +
    " | Planned Gleis: " + agent.plannedPlatform
);

recordScenarioTrain(agent);]]></Code>
							</Value>
