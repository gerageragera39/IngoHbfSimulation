				<EmbeddedObject>
					<Id>1794772727390</Id>
					<Name><![CDATA[LeftHBF]]></Name>
					<X>930</X><Y>370</Y>
					<Label><X>-10</X><Y>-20</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<ActiveObjectClass>
						<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
						<ClassName><![CDATA[Sink]]></ClassName>
					</ActiveObjectClass>
					<GenericParameterSubstitute>
						<GenericParameterSubstituteReference>
							<PackageName><![CDATA[com.anylogic.libraries.processmodeling]]></PackageName>
							<ClassName><![CDATA[Sink]]></ClassName>
							<ItemName><![CDATA[1412336242929]]></ItemName>
						</GenericParameterSubstituteReference>
					</GenericParameterSubstitute>
					<Parameters>
						<Parameter>
							<Name><![CDATA[onEnter]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[
agent.actualDeparture = time();

// Самое раннее возможное отправление
double earliestDeparture = Math.max(
    agent.scheduledDeparture,
    agent.readyTime + agent.minDwell
);

// Вторичная задержка
agent.stationDelay = Math.max(
    0.0,
    agent.actualDeparture - earliestDeparture
);

// Записываем результаты поезда
recordTrainResult(agent);

// Обновляем общие показатели
completed++;
totalStationDelay += agent.stationDelay;

traceln(
    "DEPARTURE | " + agent.trainId +
    " | Gleis " + agent.assignedPlatform +
    " | Time: " + time() +
    " | Station delay: " + agent.stationDelay
);

// Освобождаем платформу
occupied[agent.assignedPlatform] = false;

// Ищем следующего ожидающего поезда
dispatchTrains();

// Сохраняем промежуточные результаты
// каждые 20 завершённых поездов
if (completed % 20 == 0 ||
    completed == 2 * trainsPerDirection) {

    saveResultsCsv();
    saveScenarioCsv();
}

// Итоговый отчёт
if (completed == 2 * trainsPerDirection) {

    traceln("========== FINISHED ==========");

    traceln(
        "Completed trains: " + completed
    );

    traceln(
        "Total station delay: " +
        totalStationDelay
    );

    traceln(
        "Average station delay: " +
        totalStationDelay / completed
    );

    traceln(
        "Average waiting time: " +
        totalWaitingTime / completed
    );

    traceln(
        "Platform reassignments: " +
        reassignmentCount
    );

    traceln(
        "================================"
    );
}
]]></Code>
							</Value>
