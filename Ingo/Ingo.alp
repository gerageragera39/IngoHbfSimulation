			<Functions>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[boolean]]></ReturnType>
					<Id>1794772703414</Id>
					<Name><![CDATA[canUse]]></Name>
					<X>60</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[TrainRequest]]></Type>
					</Parameter>
					<Parameter>
						<Name><![CDATA[p]]></Name>
						<Type><![CDATA[int]]></Type>
					</Parameter>
					<Body><![CDATA[
if (t.allowedPlatforms == null) {
    return false;
}

for (int allowed : t.allowedPlatforms) {
    if (allowed == p) {
        return true;
    }
}

return false;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[int]]></ReturnType>
					<Id>1794774146917</Id>
					<Name><![CDATA[choosePlatform]]></Name>
					<X>160</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[TrainRequest]]></Type>
					</Parameter>
					<Body><![CDATA[
int p = t.plannedPlatform;

// FIXED_DB: только плановая платформа
if ("FIXED_DB".equals(policy)) {

    if (p >= 2 && p <= 5 &&
        canUse(t, p) && !occupied[p]) {
        return p;
    }

    return -1;
}

// GREEDY: свободная разрешённая платформа
if ("GREEDY".equals(policy)) {

    // Сначала предпочитаем плановую платформу
    if (p >= 2 && p <= 5 &&
        canUse(t, p) && !occupied[p]) {
        return p;
    }

    // Если она занята — ищем альтернативу
    for (int platform = 2; platform <= 5; platform++) {

        if (canUse(t, platform) &&
            !occupied[platform]) {
            return platform;
        }
    }

    return -1;
}

throw new IllegalStateException(
    "Unknown dispatch policy: " + policy
);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794774228877</Id>
					<Name><![CDATA[dispatchTrains]]></Name>
					<X>320</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[
while (true) {

    TrainRequest selected = null;
    int selectedPlatform = -1;

    // Проверяем поезда в общей очереди Wait
    for (int i = 0; i < wait.size(); i++) {

        TrainRequest t = wait.get(i);

        // Этот поезд уже получил назначение
        if (t.assignedPlatform != -1) {
            continue;
        }

        int p = choosePlatform(t);

        // Свободной допустимой платформы нет
        if (p == -1) {
            continue;
        }

        // Выбираем поезд с наиболее ранним
        // временем готовности.
        // При равенстве — по порядку появления.
        if (selected == null ||
            t.readyTime < selected.readyTime ||
            (t.readyTime == selected.readyTime &&
             t.sequence < selected.sequence)) {

            selected = t;
            selectedPlatform = p;
        }
    }

    // Больше никого сейчас назначить нельзя
    if (selected == null) {
        break;
    }

    // Резервируем платформу
    occupied[selectedPlatform] = true;
    selected.assignedPlatform = selectedPlatform;

    traceln(
        "DISPATCH | Train: " + selected.trainId +
        " | Gleis: " + selectedPlatform +
        " | Time: " + time()
    );

    // Выпускаем выбранный поезд из Wait
    boolean released = wait.free(selected);

    if (!released) {

        occupied[selectedPlatform] = false;
        selected.assignedPlatform = -1;

        throw new IllegalStateException(
            "Could not release train " + selected.trainId
        );
    }
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794835926299</Id>
					<Name><![CDATA[recordTrainResult]]></Name>
					<X>480</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[TrainRequest]]></Type>
					</Parameter>
					<Body><![CDATA[
 // Проверяем корректность назначения
if (!canUse(t, t.assignedPlatform)) {
    throw new IllegalStateException(
        "Invalid platform for train " + t.trainId
    );
}

// Время ожидания до занятия платформы
double waitingTime = Math.max(
    0.0,
    t.actualArrival - t.readyTime
);

// Было ли переназначение платформы
int reassigned = (
    t.assignedPlatform != t.plannedPlatform
) ? 1 : 0;

// Проверяем минимальную стоянку
if (t.actualDeparture + 1e-8 <
    t.actualArrival + t.minDwell) {
    throw new IllegalStateException(
        "Minimum dwell violated: " + t.trainId
    );
}

// Экранируем текстовые значения для CSV
String id = "\"" +
    t.trainId.replace("\"", "\"\"") + "\"";

String route = "\"" +
    t.routeGroup.replace("\"", "\"\"") + "\"";

// Формируем строку CSV
String row = String.join(",",
    policy,
    id,
    route,
    String.valueOf(t.plannedPlatform),
    String.valueOf(t.assignedPlatform),
    String.valueOf(t.scheduledArrival),
    String.valueOf(t.scheduledDeparture),
    String.valueOf(t.incomingDelay),
    String.valueOf(t.readyTime),
    String.valueOf(t.actualArrival),
    String.valueOf(t.actualDeparture),
    String.valueOf(t.minDwell),
    String.valueOf(waitingTime),
    String.valueOf(t.stationDelay),
    String.valueOf(reassigned)
);

// Сохраняем строку в памяти
resultRows.add(
    row + "," + scenarioId + "," + scenarioSeed
);

// Обновляем общую статистику
totalWaitingTime += waitingTime;
reassignmentCount += reassigned;
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794835966342</Id>
					<Name><![CDATA[saveResultsCsv]]></Name>
					<X>660</X><Y>650</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[
try {

    // Создаём папку results
    java.nio.file.Path folder =
        java.nio.file.Paths.get("results");

    java.nio.file.Files.createDirectories(folder);

    // Имя файла зависит от стратегии
    String fileName =
	    "train_results_" + policy +
	    "_" + scenarioId +
	    "_seed" + scenarioSeed + ".csv";

    java.nio.file.Path output =
        folder.resolve(fileName);

    // Заголовок CSV
    String header = String.join(",",
        "policy",
        "train_id",
        "route_group",
        "planned_platform",
        "assigned_platform",
        "scheduled_arrival",
        "scheduled_departure",
        "incoming_delay",
        "ready_time",
        "platform_arrival",
        "actual_departure",
        "min_dwell",
        "waiting_min",
        "station_delay_min",
        "reassigned",
		"scenario_id",
		"scenario_seed"
    );

    java.util.ArrayList<String> lines =
        new java.util.ArrayList<String>();

    lines.add(header);
    lines.addAll(resultRows);

    // Записываем CSV в UTF-8
    java.nio.file.Files.write(
        output,
        lines,
        java.nio.charset.StandardCharsets.UTF_8
    );

    traceln(
        "CSV SAVED | " +
        output.toAbsolutePath() +
        " | Rows: " + resultRows.size()
    );

} catch (java.io.IOException e) {

    throw new RuntimeException(
        "Failed to export train results", e
    );
}
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>RETURNS_VALUE</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794839303874</Id>
					<Name><![CDATA[generateIncomingDelay]]></Name>
					<X>825</X><Y>645</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[trainId]]></Name>
						<Type><![CDATA[String]]></Type>
					</Parameter>
					<Body><![CDATA[
if (zeroDelayProbability < 0.0 ||
    zeroDelayProbability > 1.0 ||
    meanPositiveDelay <= 0.0 ||
    maxIncomingDelay <= 0.0) {

    throw new IllegalArgumentException(
        "Invalid delay distribution parameters"
    );
}

// Generate a deterministic seed for each train
long z =
    1000003L * (long) scenarioSeed +
    (long) trainId.hashCode();

// SplitMix64 bit mixing
z = (z ^ (z >>> 30)) * 0xbf58476d1ce4e5b9L;
z = (z ^ (z >>> 27)) * 0x94d049bb133111ebL;
z = z ^ (z >>> 31);

// Independent deterministic random stream
java.util.Random rng = new java.util.Random(z);

// Probability of zero incoming delay
if (rng.nextDouble() < zeroDelayProbability) {
    return 0.0;
}

// Positive delay: exponential distribution
double u = rng.nextDouble();

double delay =
    -meanPositiveDelay * Math.log1p(-u);

// Upper limit for incoming delay
return Math.min(delay, maxIncomingDelay);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794839540781</Id>
					<Name><![CDATA[recordScenarioTrain]]></Name>
					<X>65</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Parameter>
						<Name><![CDATA[t]]></Name>
						<Type><![CDATA[TrainRequest]]></Type>
					</Parameter>
					<Body><![CDATA[
// Разрешённые платформы
StringBuilder allowed = new StringBuilder();

for (int i = 0; i < t.allowedPlatforms.length; i++) {

    if (i > 0) {
        allowed.append("|");
    }

    allowed.append(t.allowedPlatforms[i]);
}

// Строка исходного сценария
String row = String.join(",",
    scenarioId,
    String.valueOf(scenarioSeed),
    t.trainId,
    t.routeGroup,
    String.valueOf(t.plannedPlatform),
    String.valueOf(t.scheduledArrival),
    String.valueOf(t.scheduledDeparture),
    String.valueOf(t.incomingDelay),
    String.valueOf(t.readyTime),
    allowed.toString()
);

scenarioRows.add(row);
]]></Body>
				</Function>
				<Function AccessType="default" StaticFunction="false">
					<ReturnModificator>VOID</ReturnModificator>
					<ReturnType><![CDATA[double]]></ReturnType>
					<Id>1794839599852</Id>
					<Name><![CDATA[saveScenarioCsv]]></Name>
					<X>290</X><Y>700</Y>
					<Label><X>10</X><Y>0</Y></Label>
					<PublicFlag>false</PublicFlag>
					<PresentationFlag>true</PresentationFlag>
					<ShowLabel>true</ShowLabel>
					<Body><![CDATA[
try {

    java.nio.file.Path folder =
        java.nio.file.Paths.get("results");

    java.nio.file.Files.createDirectories(folder);

    String fileName =
        "delay_scenarios_" +
        scenarioId +
        "_seed" + scenarioSeed + ".csv";

    java.nio.file.Path output =
        folder.resolve(fileName);

    String header = String.join(",",
        "scenario_id",
        "scenario_seed",
        "train_id",
        "route_group",
        "planned_platform",
        "scheduled_arrival",
        "scheduled_departure",
        "incoming_delay",
        "ready_time",
        "allowed_platforms"
    );

    java.util.ArrayList<String> lines =
        new java.util.ArrayList<String>();

    lines.add(header);
    lines.addAll(scenarioRows);

    java.nio.file.Files.write(
        output,
        lines,
        java.nio.charset.StandardCharsets.UTF_8
    );

    traceln(
        "SCENARIO SAVED | " +
        output.toAbsolutePath() +
        " | Trains: " + scenarioRows.size()
    );

} catch (java.io.IOException e) {

    throw new RuntimeException(
        "Failed to save delay scenario", e
    );
}
]]></Body>
				</Function>
			</Functions>

