						<Parameter>
							<Name><![CDATA[onExit]]></Name>
							<Value Class="CodeValue">
								<Code><![CDATA[
int i = northSeq++;

agent.sequence = trainSeq++;
agent.trainId = "N" + (i + 1);


agent.scheduledArrival = time();

agent.incomingDelay =
    generateIncomingDelay(agent.trainId);

agent.readyTime =
    agent.scheduledArrival + agent.incomingDelay;


agent.minDwell = 3;
agent.scheduledDeparture = time() + 5;

agent.assignedPlatform = -1;

switch (i % 3) {

    case 0:
        agent.routeGroup = "RB16_S";
        agent.plannedPlatform = 2;
        agent.allowedPlatforms = new int[]{2, 3};
        break;

    case 1:
        agent.routeGroup = "RE1_S";
        agent.plannedPlatform = 3;
        agent.allowedPlatforms = new int[]{2, 3, 5};
        break;

    default:
        agent.routeGroup = "ICE_S";
        agent.plannedPlatform = 3;
        agent.allowedPlatforms = new int[]{3};
        break;
}

traceln(
    "NEW TRAIN | " + agent.trainId +
    " | " + agent.routeGroup +
    " | Planned Gleis: " + agent.plannedPlatform
);

recordScenarioTrain(agent);
]]></Code>
